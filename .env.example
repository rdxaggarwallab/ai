# Copy to .env and fill in. Never commit .env.
# Make each secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
DB_PASSWORD=
# Port the site is served on (put HTTPS in front, e.g. Caddy or the institute's proxy).
WEB_PORT=80
# Login cookies are HTTPS-only by default. Set to false ONLY for a short test on plain http.
COOKIE_SECURE=true
